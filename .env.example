# Copy this file to .env and fill in the values. Never commit .env.

# Nebius Token Factory (OpenAI-compatible API)
NEBIUS_API_KEY=
# Optional: leave empty to use the base URL in config.yaml
NEBIUS_BASE_URL=

# Tavily search API
TAVILY_API_KEY=

# Public demo spending caps in USD (optional; defaults are in config.yaml)
DEMO_DAILY_BUDGET_USD=
DEMO_TOTAL_BUDGET_USD=
# Public demo caps on Tavily credits (optional; defaults are in config.yaml)
DEMO_TAVILY_DAILY_CREDITS=
DEMO_TAVILY_TOTAL_CREDITS=
# Live diagnoses per visit before recordings are shown (optional; default in config.yaml)
DEMO_LIVE_RUNS_PER_VISIT=
